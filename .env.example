# Copy this file to `.env` (Next.js and drizzle-kit both read `.env`).
# Never commit `.env`; it is ignored by git.

# PostgreSQL connection string for a database you have already created.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# Secret key used to sign and encrypt session cookies (HMAC-SHA256).
# Generate a strong secret (e.g. `openssl rand -base64 32`) for production.
AUTH_SECRET=your_secret_key_here_at_least_32_chars

